{
  "name": "devlens",
  "displayName": "DevLens",
  "description": "Understand your codebase through architecture and code relationships.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  
"contributes": {
    "commands": [
        {
            "command": "devlens.analyzeProject",
            "title": "DevLens: Analyze Project"
        },
        {
            "command": "devlens.visualizeArchitecture",
            "title": "DevLens: Visualize Architecture"
        },
        {
            "command": "devlens.exploreRelationships",
            "title": "DevLens: Explore Code Relationships"
        },
        {
            "command": "devlens.explainCode",
            "title": "DevLens: Why Is This Code Here?"
        },
        {
            "command": "devlens.analyzeImpact",
            "title": "DevLens: Analyze Impact"
        },
        {
            "command": "devlens.detectArchitecture",
            "title": "DevLens: Detect Architecture"
        },
        {
            "command": "devlens.traceFlow",
            "title": "DevLens: Trace Flow"
        },
        {
            "command": "devlens.openDashboard",
            "title": "DevLens: Open Project Dashboard"
        }
    ],
    "viewsContainers": {
        "activitybar": [
            {
                "id": "devlens",
                "title": "DevLens",
                "icon": "resources/devlens.svg"
            }
        ]
    },
    "views": {
        "devlens": [
            {
                "id": "devlens.projectView",
                "name": "Project",
                "icon": "resources/devlens.svg"
            }
        ]
    },
    "menus": {
        "editor/context": [
            {
                "command": "devlens.explainCode",
                "group": "navigation@100",
                "when": "editorTextFocus"
            },
            {
                "command": "devlens.analyzeImpact",
                "group": "navigation@101",
                "when": "editorTextFocus"
            },
            {
                "command": "devlens.traceFlow",
                "group": "navigation@102",
                "when": "editorTextFocus"
            }
        ]
    },
    "configuration": {
        "title": "DevLens",
        "properties": {
            "devlens.exclude": {
                "type": "array",
                "items": { "type": "string" },
                "default": [],
                "markdownDescription": "Additional directory names to exclude from DevLens scanning and analysis (e.g. `[\"coverage\", \"tmp\", \"generated\"]`). The built-in defaults (`node_modules`, `.git`, `dist`, `build`, `out`, etc.) are always excluded."
            },
            "devlens.traceMaxDepth": {
                "type": "number",
                "default": 8,
                "minimum": 2,
                "maximum": 20,
                "description": "Maximum call-chain depth for DevLens: Trace Flow."
            },
            "devlens.showExternalImports": {
                "type": "boolean",
                "default": false,
                "description": "Reserved for future use: include external package imports in the architecture graph."
            },
            "devlens.enableFileWatching": {
                "type": "boolean",
                "default": true,
                "description": "Automatically update DevLens analysis incrementally in the background when files are saved or modified."
            }
        }
    }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
