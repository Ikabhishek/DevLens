{
  "name": "devlens",
  "displayName": "DevLens",
  "description": "Understand your codebase through architecture and code relationships.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  
"contributes": {
    "commands": [
        {
            "command": "devlens.analyzeProject",
            "title": "DevLens: Analyze Project"
        },
        {
            "command": "devlens.visualizeArchitecture",
            "title": "DevLens: Visualize Architecture"
        }
    ],
    "viewsContainers": {
        "activitybar": [
            {
                "id": "devlens",
                "title": "DevLens",
                "icon": "resources/devlens.svg"
            }
        ]
    },
    "views": {
        "devlens": [
            {
                "id": "devlens.projectView",
                "name": "Project",
                "icon": "resources/devlens.svg"
            }
        ]
    }
}
,
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
